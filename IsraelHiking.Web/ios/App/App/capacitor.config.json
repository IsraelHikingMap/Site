		"TextZoomPlugin",
		"AppUpdatePlugin",
		"MailComposerPlugin",
		"BackgroundGeolocation",
		"CapgoCompassPlugin",
		"CapgoInAppBrowserPlugin",
		"CapacitorShareTargetPlugin",
		"SpeechSynthesisPlugin",
