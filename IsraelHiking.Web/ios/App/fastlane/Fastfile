# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Build the iOS app only"
  lane :build_ios do |options|
    setup_ci
    # -showBuildSettings needs longer than the 3 second default here. Cap the retries
    # too, so a genuine hang fails in minutes instead of 3+6+12+24 escalating attempts.
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "180"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] ||= "2"
    # The share extension is a second target with its own app id, so it needs its own profile.
    sync_code_signing(type: "appstore", app_identifier: ["com.mapeak", "com.mapeak.ShareExtension"])
    # Where CI resolved the packages. Derived from this file's own location rather
    # than an env var or lane argument, both of which have silently arrived empty.
    spm_cache = options[:spm_cache] || File.expand_path("../../.spm-cache", __dir__)
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      # Without an explicit destination, fastlane's -showBuildSettings call omits
      # -destination and xcodebuild has to work one out itself, which hangs on CI
      # runners (fastlane#4059). The same command with this flag returns immediately.
      destination: "generic/platform=iOS",
      # Raw xcodebuild output. xcpretty hides SPM binary-artifact download progress,
      # so a stall there is indistinguishable from a hung build.
      xcodebuild_formatter: "",
      # Packages are resolved once by a CI step before this lane runs. Re-resolving
      # here re-downloads ~500MB of xcframeworks, which is what was timing out.
      skip_package_dependencies_resolution: true,
      cloned_source_packages_path: spm_cache,
      export_options: {
        provisioningProfiles: {
          "com.mapeak" => "match AppStore com.mapeak",
          "com.mapeak.ShareExtension" => "match AppStore com.mapeak.ShareExtension"
        }
      }
    )
  end
  desc "Upload the previously built IPA to TestFlight"
  lane :upload_to_testers do
    setup_ci
    app_store_connect_api_key(
      key_id: "BTS253W4SC",
      issuer_id: "3a1173da-1717-450e-b168-14d039b851a1",
      key_content: ENV["APPSTORE_CONNECT_API_KEY"], # The content of the .p8 file
      in_house: false # optional but may be required if using match/sigh
    )
    upload_to_testflight(
      ipa: "App.ipa"
    )
  end
  lane :upload_to_production do
    setup_ci
    app_store_connect_api_key(
      key_id: "BTS253W4SC",
      issuer_id: "3a1173da-1717-450e-b168-14d039b851a1",
      key_content: ENV["APPSTORE_CONNECT_API_KEY"], # The content of the .p8 file
      in_house: false # optional but may be required if using match/sigh
    )
    deliver(
      force: true,  # Skip HTML report verification
      skip_screenshots: false,  # Set to true to skip screenshots if unchanged
      skip_metadata: false, # This is needed to publish the release notes, those are updated through the CI
      submit_for_review: true,  # Automatically submits the build for review
      run_precheck_before_submit: false,  # Precheck cannot check In-app purchases with the App Store Connect API Key (yet)
      ipa: "App.ipa"
    )
  end
end
