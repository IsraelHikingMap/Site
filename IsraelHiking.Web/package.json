  "scripts": {
    "ng": "ng",
    "build": "ng build --configuration development",
    "build:watch": "ng build --configuration development --watch",
    "build:prod": "npm run generate-user-data-types && ng build --configuration production",
    "build:mobile": "npm run generate-user-data-types && ng build -c mobile",
    "build:mobile-watch": "ng build -c mobile-debug --watch",
    "cap:update": "npx cap sync && xcodebuild -resolvePackageDependencies -project ios/App/App.xcodeproj -scheme App",
    "test": "ng test",
    "test-ci": "npm run generate-user-data-types && ng test --coverage",
    "lint": "ng lint --fix",
    "extract": "node ./scripts/extract-strings.ts",
    "generate-legend": "node ./scripts/generate-legend.ts",
    "generate-sprite": "node ./scripts/generate-sprite.ts",
    "generate-icon-font": "node ./scripts/generate-icon-font.ts",
    "generate-offline-areas": "node ./scripts/generate-offline-areas.ts",
    "generate-user-data-types": "openapi-typescript https://raw.githubusercontent.com/Mapeak-com/user-data/refs/heads/main/user-data.openapi.yml -o ./src/application/models/user-data.g.d.ts",
    "set-version": "node ./scripts/set-version.ts",
    "postinstall": "patch-package"
  },
